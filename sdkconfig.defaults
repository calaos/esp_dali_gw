CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# A bad OTA image must be able to fall back to the previous slot; the app marks itself valid only
# after Wi-Fi is up and the bus task has completed one transaction (SPEC 12).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

CONFIG_ESP_TASK_WDT_EN=y

CONFIG_HTTPD_WS_SUPPORT=n
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_ESP_WIFI_NVS_ENABLED=y

# Without this, esp_netif_sntp_init() refuses a configuration that asks for the DHCP-supplied NTP
# server and SNTP never starts at all -- not even on the fallback pool. The network's own server is
# also the better one to use.
CONFIG_LWIP_DHCP_GET_NTP_SRV=y

CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_STACK_CHECK_MODE_NORM=y

# CONFIG_COMPILER_DISABLE_DEFAULT_ERRORS is deliberately left unset: warnings are errors.
